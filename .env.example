# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored — never commit real keys.

# --- Supabase (public values; safe for the browser) ---
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# --- Site ---
# Your production URL (used for canonical URLs, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Upload limits enforced in the admin UI (MB) ---
# Must not exceed the global upload limit of your Supabase project
# (Dashboard → Storage → Settings). Free plan: 50 MB.
NEXT_PUBLIC_MAX_VIDEO_UPLOAD_MB=50
NEXT_PUBLIC_MAX_IMAGE_UPLOAD_MB=10

# NEVER add SUPABASE_SERVICE_ROLE_KEY here — this app does not need it.
